{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/dashboard(?:/.*)?$",
      "dest": "/index.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      }
    },
    {
      "src": "^/$",
      "dest": "https://musliman-academy-public.vercel.app/"
    },
    {
      "src": "^/(en|ar|es|de|it|ur|tr)/?$",
      "dest": "https://musliman-academy-public.vercel.app/$1"
    },
    {
      "src": "^/(en|ar|es|de|it|ur|tr)/(.*)$",
      "dest": "https://musliman-academy-public.vercel.app/$1/$2"
    },
    {
      "src": "^/_next/(.*)$",
      "dest": "https://musliman-academy-public.vercel.app/_next/$1"
    },
    {
      "src": "^/(sitemap\\.xml|robots\\.txt|manifest\\.webmanifest|opengraph-image)$",
      "dest": "https://musliman-academy-public.vercel.app/$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}
